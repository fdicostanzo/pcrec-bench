pattern ^(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)$
name ipv4-near-miss
tag family=wild-validator, hazard=none
provenance
  source authored
  retrieved 2026-09-16
  license n-a
  fidelity synthesized
  adaptation |
    the classic "\d{1,3} per octet" IPv4 regex gotcha, documented across regex-validator writeups; the family's own stress mechanism, verbatim: "class-heavy, anchored, alternation-of-ranges" (capability_set_v1.md §3.1 family 1)

pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$
name uuid-near-miss
tag family=wild-validator, hazard=none
provenance
  source authored
  retrieved 2026-09-16
  license n-a
  fidelity synthesized
  adaptation |
    RFC 4122 §4.1.3 (the UUID version/variant nibble constraint); pairs against L1's imported grok UUID pattern named in capability_set_v1.md §3.1 family 1

pattern ^[a-zA-Z0-9_+&*-]+(?:\.[a-zA-Z0-9_+&*-]+)*@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$

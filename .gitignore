# The session hand-off brief is deliberately NOT project record (same rule
# as pcrec: a rule a tool enforces beats a rule a comment states).
/docs/dev/wake.md
# Subagent worktrees live inside the repo so the scope mandate holds by
# construction; they are never committed.
worktrees/
# Build products of testee adapters and vendored engines.
build/
testees/pcrec/build/
# GENERATED sub-bench subject trees: reproduced byte for byte by the
# generators next to them, pinned by the COMMITTED manifests (harness
# contract 2). Committing a megabyte of 'a' would be committing a
# derivation of a two-line script.
bench/*/subjects/
bench/*/throughput/
build-*/
vendor/*/build/
__pycache__/
*.pyc
*.o
*.a
/core
/core.*
# Python project scaffolding (BD4)
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# a record the validator REFUSED at write stays out of the tree ([B36] incident 2026-09-06: six .rejected files
# were committed by a blind `git add store/`); the harness stages under .staging-* and leaves .rejected behind
.staging-*/
*.rejected
